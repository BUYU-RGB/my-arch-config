#!/usr/bin/env bash
set -euo pipefail

private=false
if [[ "${1:-}" == "--private" ]]; then
  private=true
fi

if command -v chromium >/dev/null 2>&1; then
  if [[ "$private" == true ]]; then
    exec uwsm-app -- chromium --incognito
  fi
  exec uwsm-app -- chromium
fi

if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open about:blank
fi

notify-send -u critical "Browser unavailable" "Install chromium or another xdg-open capable browser." 2>/dev/null || true
exit 1
