#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/my-arch"
state_file="$state_dir/opaque"
mkdir -p "$state_dir"

if [[ -f "$state_file" ]]; then
  rm -f "$state_file"
  hyprctl keyword windowrule "opacity 0.97 0.9, match:tag default-opacity"
else
  touch "$state_file"
  hyprctl keyword windowrule "opacity 1 1, match:tag default-opacity"
fi
