#!/usr/bin/env bash
set -euo pipefail

name="${1:?name required}"
url="${2:?url required}"

class="my-webapp-$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd '[:alnum:]-')"

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if hyprctl clients -j | jq -e --arg class "$class" '.[] | select(.class == $class)' >/dev/null; then
    hyprctl dispatch focuswindow "class:^${class}$" >/dev/null
    exit 0
  fi
fi

if command -v chromium >/dev/null 2>&1; then
  exec uwsm-app -- chromium --class="$class" --app="$url"
fi

exec xdg-open "$url"
