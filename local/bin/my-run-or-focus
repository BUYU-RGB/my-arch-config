#!/usr/bin/env bash
set -euo pipefail

pattern="${1:?class pattern required}"
shift

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if hyprctl clients -j | jq -e --arg pattern "$pattern" '.[] | select(.class | test($pattern; "i"))' >/dev/null; then
    hyprctl dispatch focuswindow "class:${pattern}" >/dev/null
    exit 0
  fi
fi

if (($# == 0)); then
  exit 0
fi

exec uwsm-app -- "$@"
