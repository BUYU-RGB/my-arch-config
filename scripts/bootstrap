#!/usr/bin/env bash
set -euo pipefail

repo_url="${1:-}"
target_dir="${2:-$HOME/my-arch-config}"

if [[ -z "$repo_url" ]]; then
  echo "Usage: bootstrap <git-repo-url> [target-dir]" >&2
  exit 2
fi

pacman_args=(-Syu --needed git base-devel)
if [[ "${NONINTERACTIVE:-0}" == "1" ]]; then
  pacman_args+=(--noconfirm)
fi

sudo pacman "${pacman_args[@]}"

if [[ -d "$target_dir/.git" ]]; then
  git -C "$target_dir" pull --ff-only
else
  git clone "$repo_url" "$target_dir"
fi

exec "$target_dir/install.sh"
