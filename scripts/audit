#!/usr/bin/env bash

set -euo pipefail

bash -n install.sh scripts/bootstrap scripts/clean-apps scripts/backup-current scripts/audit local/bin/my-*

if command -v jq >/dev/null 2>&1; then
  jq empty config/waybar/config.jsonc
else
  echo "jq not found; skipping Waybar JSON check." >&2
fi

if command -v rg >/dev/null 2>&1; then
  pattern='omarch''y|OMARCHY_PATH|\.local/share/omarchy'

  if rg -ni "$pattern" . \
    --glob '!scripts/audit' \
    --glob '!.git/**'; then
    echo "Found external runtime residue above." >&2
    exit 1
  fi
else
  echo "ripgrep not found; skipping external runtime residue check." >&2
fi

git status --short
